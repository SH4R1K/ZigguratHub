# Шаблон для docker compose: скопируй в .env и заполни реальные значения.
# .env в git не коммитится (см. .gitignore).
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Прокси для исходящих запросов к OpenRouter (включается только при UseProxy=true).
# Форматы: http://host:port, https://host:port, socks4://host:port, socks4a://host:port, socks5://user:pass@host:port.
# Прокси должен быть за пределами РФ.
OPENROUTER_USE_PROXY=false
OPENROUTER_PROXY_URL=socks5://user:pass@host:port